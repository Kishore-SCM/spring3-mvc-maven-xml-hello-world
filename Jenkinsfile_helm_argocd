pipeline {
    agent {
        kubernetes {
            yamlFile 'jenkins-k8s-agent.yaml'
        }
    }

    environment {
        AWS_REGION = "ap-south-1"
        ECR_REPO_NAME = "springapp-helm"
        ECR_REGISTRY = "060795946012.dkr.ecr.ap-south-1.amazonaws.com"
        IMAGE_TAG = "latest"
        DOCKER_IMAGE = " 060795946012.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO_NAME}:${IMAGE_TAG}"
        APP_REPO = "https://github.com/jmstechhome28/spring3-mvc-maven-xml-hello-world.git"
        HELM_REPO = "git@github.com:jmstechhome28/springapp-helm.git" 
        HELM_CHART_DIR = "springapp-helm"
        HELM_VALUES_FILE = "values.yaml"
        ARGOCD_APP_NAME = "springapp"
    }

    triggers {
        pollSCM('* * * * *')  // Check for new commits every minute
    }

    stages {
     stage('Check Prerequisites') {
            steps {
                script {
                    echo "Checking if all required tools are installed..."
                }
                
                container('docker') {
                    sh 'echo "Checking Docker..."; docker --version || echo "Docker is not installed!"'
                }
                
                container('maven') {
                    sh 'echo "Checking Maven..."; mvn -version || echo "Maven is not installed!"'
                }
                
                container('java8') {
                    sh 'echo "Checking Java..."; java -version || echo "Java is not installed!"'
                }
                
                container('helm') {
                    sh 'echo "Checking Helm..."; helm version || echo "Helm is not installed!"'
                }
                
                container('git') {
                    sh 'echo "Checking Git..."; git --version || echo "Git is not installed!"'
                }
                
                container('aws-cli') {
                    sh 'echo "Checking AWS CLI..."; aws --version || echo "AWS CLI is not installed!"'
                }
            }
         }
        stage('Clone Application Repository') {
            steps {
                container('git') {
                    script {
                        echo "Cloning application repository..."
                        git branch: 'master', url: "${APP_REPO}", credentialsId: 'github-credentials'
                    }
                }
            }
        }

       stage('Build and Package App') {
           steps {
             container('maven') {
               script {
                    echo "Building application using Maven..."
                       sh 'mvn clean package -DskipTests'
                  }
            }
           }
     }
        stage('Login to AWS ECR') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
                    script {
                        container('aws-cli') {  
                            echo "Fetching AWS ECR login password..."
                            sh '''
                            export AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
                            export AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}

                            # Get AWS ECR login password and store it in a shared volume
                            aws ecr get-login-password --region ${AWS_REGION} > /shared/ecr_password.txt
                            chmod 600 /shared/ecr_password.txt
                            '''
                        }
                        container('docker') {  
                            echo "Logging into AWS ECR..."
                            sh '''
                            if [ -f /shared/ecr_password.txt ]; then
                                cat /shared/ecr_password.txt | docker login --username AWS --password-stdin ${ECR_REGISTRY}
                            else
                                echo "Error: ECR password file not found!"
                                exit 1
                            fi
                            '''
                        }
                    }
                }
            }
        }


    stage('Build and Push Docker Image') {
             steps {
                container('docker') {
                     script {
                    echo "Building Docker image..."
                       sh 'docker build -t ${DOCKER_IMAGE} .'

                   echo "Pushing Docker image to ECR..."
                      sh 'docker push ${DOCKER_IMAGE}'
                     }
              }
           }
       }

         stage('update the helm chart') {
             steps {
                 container('git') {
                     script {
                         sh """
                            echo "Cloning Helm repository..."
                             mkdir -p /home/jenkins/.ssh
                             chmod 700 /home/jenkins/.ssh
                             cp /ssh-key/id_ed25519 /home/jenkins/.ssh/id_ed25519
                             cp /ssh-key/id_ed25519.pub /home/jenkins/.ssh/id_ed25519.pub
                             chmod 600 /home/jenkins/.ssh/id_ed25519
                             ssh-keyscan -t ed25519 github.com >> /home/jenkins/.ssh/known_hosts
                             chmod 644 /home/jenkins/.ssh/known_hosts
                             eval `ssh-agent -s`
                             ssh-add /home/jenkins/.ssh/id_ed25519
                             rm -rf ${HELM_CHART_DIR}
                             ssh -i /home/jenkins/.ssh/id_ed25519 -o UserKnownHostsFile=/home/jenkins/.ssh/known_hosts" git clone ${HELM_REPO} ${HELM_CHART_DIR}
                             echo "Updating Helm values.yaml with new Docker image..."                     
                             ls -ltr
                             cd ${HELM_CHART_DIR}  
                             #git fetch --all
                             git pull origin master || true
                             git checkout master
                             apk add --no-cache bash sed 
                             sed -i 's|tag: .*|tag: "latest"|' values.yaml
                             echo "Committing and pushing Helm changes..."
                             git config user.email "jmstechhome28@gmail.com"
                             git config user.name "Jenkins CI"
                             git add ${HELM_VALUES_FILE}
                             git commit -m "Updated image to ${DOCKER_IMAGE}"
                             ssh -i /home/jenkins/.ssh/id_ed25519 -o UserKnownHostsFile=/home/jenkins/.ssh/known_hosts" git push origin master
                         """

                     }
                 }
             }
         }

    //     stage('Trigger ArgoCD Sync') {
    //         steps {
    //             container('helm') {
    //                 script {
    //                     echo "Triggering ArgoCD sync..."
    //                     sh """
    //                         argocd app sync ${ARGOCD_APP_NAME}
    //                         argocd app wait ${ARGOCD_APP_NAME} --health
    //                     """
    //                 }
    //             }
    //         }
    //     }
     }

    post {
        success {
            echo "Deployment successful!"
        }
        failure {
            echo "Deployment failed. Check logs!"
        }
    }
}
