pipeline {
    agent {
        kubernetes {
            yamlFile 'jenkins-k8s-agent.yaml'
        }
    }
    environment {
        AWS_REGION = "ap-south-1"
        ECR_REPO_NAME = "springapp-helm"
        ECR_REGISTRY = "060795946012.dkr.ecr.ap-south-1.amazonaws.com"
        GITHUB_RELEASE_TAG = ""
        DOCKER_IMAGE = "${ECR_REGISTRY}/${ECR_REPO_NAME}"
        APP_REPO = "https://github.com/jmstechhome28/spring3-mvc-maven-xml-hello-world.git"
        HELM_REPO = "git@github.com:jmstechhome28/springapp-helm.git"
        HELM_CHART_DIR = "springapp"
        HELM_VALUES_FILE = "values.yaml"
        ARGOCD_APP_NAME = "springapp"
        KUBE_CONTEXT = 'kubernetes-admin@kubernetes'
        KUBECONFIG = "/home/jenkins/.kube/config"
        ARGOCD_URL= "3.110.208.168:30421"
    }

    stages {
        stage('Check Prerequisites') {
            steps {
                script {
                    echo "Checking if all required tools are installed..."
                }

                container('docker') {
                    sh 'echo "Checking Docker..."; docker --version || echo "Docker is not installed!"'
                }
                container('maven') {
                    sh 'echo "Checking Maven..."; mvn -version || echo "Maven is not installed!"'
                }
                container('java8') {
                    sh 'echo "Checking Java..."; java -version || echo "Java is not installed!"'
                }
                container('helm') {
                    sh 'echo "Checking Helm..."; helm version || echo "Helm is not installed!"'
                }
                container('git') {
                    sh 'echo "Checking Git..."; git --version || echo "Git is not installed!"'
                }
                container('aws-cli') {
                    sh 'echo "Checking AWS CLI..."; aws --version || echo "AWS CLI is not installed!"'
                }
            }
        }

stage('Get Latest GitHub Release Tag') {
    steps {
        container('git') {
            script {
                echo "Installing curl & jq in the container..."
                sh 'apk add --no-cache curl jq'
                echo "Fetching latest GitHub release tag..."
                def tag = sh(
                    script: '''
                    curl -s -H "Accept: application/vnd.github.v3+json" \
                    https://api.github.com/repos/jmstechhome28/spring3-mvc-maven-xml-hello-world/releases/latest | jq -r '.tag_name'
                    ''',
                    returnStdout: true
                ).trim()

                if (!tag || tag == "null") {
                    error("ERROR: No valid release tag found! Ensure GitHub repository has a release.")
                }
                echo "GitHub Release Tag fetched: ${tag}"
                // Store the tag in Jenkins environment
                env.GITHUB_RELEASE_TAG = tag
                sh "echo 'GITHUB_RELEASE_TAG=${tag}' >> \$WORKSPACE/env_vars"
            }
        }
    }
 }
        stage('Clone Application Repository') {
            steps {
                container('git') {
                    script {
                        echo "Cloning application repository..."
                        git branch: 'master', url: "${APP_REPO}", credentialsId: 'github-credentials'
                    }
                }
            }
        }

        stage('Build and Package App') {
            steps {
                container('maven') {
                    script {
                        echo "Building application using Maven..."
                        sh 'mvn clean package -DskipTests'
                    }
                }
            }
        }

        stage('Login to AWS ECR') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
                    script {
                        container('aws-cli') {
                            echo "Fetching AWS ECR login password..."
                            sh '''
                            mkdir -p /shared
                            aws ecr get-login-password --region ${AWS_REGION} > /shared/ecr_password.txt
                            chmod 600 /shared/ecr_password.txt
                            '''
                        }
                        container('docker') {
                            echo "Logging into AWS ECR..."
                            sh '''
                            if [ -f /shared/ecr_password.txt ]; then
                                cat /shared/ecr_password.txt | docker login --username AWS --password-stdin ${ECR_REGISTRY}
                            else
                                echo "Error: ECR password file not found!"
                                exit 1
                            fi
                            '''
                        }
                    }
                }
            }
        }

stage('Build and Push Docker Image') {
    steps {
        container('docker') {
            script {
                sh '''
                if [ -f $WORKSPACE/env_vars ]; then
                    source $WORKSPACE/env_vars
                    echo "Reloaded GITHUB_RELEASE_TAG: $GITHUB_RELEASE_TAG"
                    echo "GITHUB_RELEASE_TAG=$GITHUB_RELEASE_TAG" >> $WORKSPACE/env_export
                else
                    echo " No env_vars file found!"
                    exit 1
                fi
                '''
                // Read the variable from the file
                def githubTag = sh(script: "cat $WORKSPACE/env_export | grep GITHUB_RELEASE_TAG | cut -d'=' -f2", returnStdout: true).trim()
                withEnv(["GITHUB_RELEASE_TAG=${githubTag}"]) {
                    echo "Building Docker image with tag: ${GITHUB_RELEASE_TAG}..."
                    sh "docker build -t ${DOCKER_IMAGE}:${GITHUB_RELEASE_TAG} ."
                    echo "Pushing Docker image to ECR..."
                    sh "docker push ${DOCKER_IMAGE}:${GITHUB_RELEASE_TAG}"
                }
            }
        }
    }
}
    stage('Update the Helm Chart') {
    steps {
        container('git') {
            script {
                // Read the stored GITHUB_RELEASE_TAG from the env file
                def githubTag = sh(script: "cat $WORKSPACE/env_export | grep GITHUB_RELEASE_TAG | cut -d'=' -f2", returnStdout: true).trim()

                // Use `withEnv` to pass it into the shell script
                withEnv(["GITHUB_RELEASE_TAG=${githubTag}"]) {
                    sh """
                    echo "Cloning Helm repository..."
                    mkdir -p /home/jenkins/.ssh
                    chmod 700 /home/jenkins/.ssh
                    cp /ssh-key/id_ed25519 /home/jenkins/.ssh/id_ed25519 || true
                    cp /ssh-key/id_ed25519.pub /home/jenkins/.ssh/id_ed25519.pub || true
                    chmod 600 /home/jenkins/.ssh/id_ed25519
                    rm -f /home/jenkins/.ssh/known_hosts
                    ssh-keyscan -t ed25519 github.com > /home/jenkins/.ssh/known_hosts
                    chmod 644 /home/jenkins/.ssh/known_hosts
                    eval `ssh-agent -s`
                    ssh-add /home/jenkins/.ssh/id_ed25519
                    rm -rf ${HELM_CHART_DIR} || true
                    export GIT_SSH_COMMAND="ssh -i /home/jenkins/.ssh/id_ed25519 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/home/jenkins/.ssh/known_hosts"
                    git clone ${HELM_REPO} springapp-helm
                    echo "Updating Helm values.yaml with new Docker image..."
                    cd springapp-helm/${HELM_CHART_DIR}
                    git pull origin master || true
                    git checkout master
                    apk add --no-cache bash sed

                    # Use GITHUB_RELEASE_TAG correctly inside the shell script
                    sed -i 's|tag: .*|tag: "'$GITHUB_RELEASE_TAG'"|' values.yaml
                    echo "Committing and pushing Helm changes..."
                    git config user.email "jmstechhome28@gmail.com"
                    git config user.name "Jenkins CI"
                    git add ${HELM_VALUES_FILE}
                    git commit -m "Updated image to $GITHUB_RELEASE_TAG"
                    git push origin master
                    """
                }
            }
        }
    }
}
        stage('Deploy & Sync ArgoCD App') {
            steps {
                container('kubectl') {
                    script {
                        echo "Deploying Application..."
                        def namespaceName = sh(script: "grep 'name:' ${WORKSPACE}/springapp-helm/springapp/namespace.yaml | awk '{print \$2}'", returnStdout: true).trim()

                    // Check if namespace exists
                    def namespaceExists = sh(script: "kubectl get namespace ${namespaceName} >/dev/null 2>&1 && echo 'yes' || echo 'no'", returnStdout: true).trim()

                    if (namespaceExists == 'yes') {
                        echo "Namespace '${namespaceName}' already exists. Skipping apply."
                    } else {
                        echo "Applying namespace configuration..."
                        sh "kubectl apply -f ${WORKSPACE}/springapp-helm/springapp/namespace.yaml"
                        echo "Namespace '${namespaceName}' created successfully!"
                    }
            
                        sh "${WORKSPACE}/springapp-helm/springapp/create_ecr_secret.sh"
          
                        sh "kubectl apply -f ${WORKSPACE}/springapp-helm/argocd-app.yaml -n argocd --server-side --force-conflicts"
                    }
                }
                container('argocd') {
                    script {
                        echo "Syncing ArgoCD Application..."
            withCredentials([usernamePassword(credentialsId: 'argocd_credentials', usernameVariable: 'ARGOCD_USER', passwordVariable: 'ARGOCD_PASS')]) {
                        echo "Logging into ArgoCD..."
                        sh """
                            argocd login ${ARGOCD_URL} --insecure --grpc-web --username \$ARGOCD_USER --password \$ARGOCD_PASS
                            argocd app sync ${ARGOCD_APP_NAME}
                            argocd app wait ${ARGOCD_APP_NAME} --health
                        """
                         }
                       }
                    }
                }
            }
        }


    post {
        success {
            echo "Deployment successful!"
        }
        failure {
            echo "Deployment failed. Check logs!"
        }
    }
}
